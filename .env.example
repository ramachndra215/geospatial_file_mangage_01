# Application Settings
APP_NAME="Geospatial File Measurement API"
APP_VERSION="1.0.0"
DEBUG=False
PORT=8000
HOST="0.0.0.0"

# Database Configuration
DATABASE_URL="sqlite:///./geospatial_measurements.db"

# Security & Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB
ALLOWED_EXTENSIONS=[".kml", ".zip"]

# Geospatial Processing
DEFAULT_ASSUMED_CRS="EPSG:4326"
